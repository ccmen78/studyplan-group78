# StudyPlan CLI demo for Windows PowerShell
#
# Usage:
#   .\demo-cli.ps1              # run with the data that is already saved
#   .\demo-cli.ps1 -Reset       # back up and clear ~/.studyplan/data.json first
#   .\demo-cli.ps1 -NoPause     # run straight through (for a quick test)
#
# This script is ASCII-only on purpose: Chinese Windows consoles default to
# GBK and the package's check-mark symbol crashes there unless UTF-8 is on.

param(
    [switch]$Reset,
    [switch]$NoPause
)

chcp 65001 | Out-Null
$env:PYTHONIOENCODING = "utf-8"
$env:PYTHONUTF8 = "1"
$ErrorActionPreference = "Stop"

$dataFile = Join-Path $HOME ".studyplan\data.json"

if ($Reset -and (Test-Path $dataFile)) {
    $backup = "$dataFile.bak-" + (Get-Date -Format "yyyyMMdd-HHmmss")
    Copy-Item $dataFile $backup
    Remove-Item $dataFile
    Write-Host "Backed up old data to: $backup" -ForegroundColor DarkGray
}

$spExe = Get-Command studyplan -ErrorAction SilentlyContinue
if (-not $spExe -and -not (Get-Command python -ErrorAction SilentlyContinue)) {
    throw "Neither 'studyplan' nor 'python' is on PATH. Activate your venv first."
}

function Run-SP([string[]]$argv) {
    if ($script:spExe) {
        & $script:spExe.Source @argv
    } else {
        & python -m studyplan.cli @argv
    }
    if ($LASTEXITCODE -ne 0) {
        throw "studyplan exited with code $LASTEXITCODE"
    }
}

function Step([string]$title) {
    Write-Host ""
    Write-Host ("=" * 64) -ForegroundColor DarkCyan
    Write-Host $title -ForegroundColor Cyan
    Write-Host ("=" * 64) -ForegroundColor DarkCyan
    if (-not $NoPause) {
        [void](Read-Host "Press Enter to continue")
    }
}

$today = Get-Date
$d3    = $today.AddDays(3).ToString("yyyy-MM-dd")
$d7    = $today.AddDays(7).ToString("yyyy-MM-dd")
$d15   = $today.AddDays(15).ToString("yyyy-MM-dd")
$exam  = $today.AddDays(25).ToString("yyyy-MM-dd")
$term  = $today.AddDays(40).ToString("yyyy-MM-dd")

Step "0) One entry point, ten commands"
if ($spExe) { & $spExe.Source --help } else { & python -m studyplan.cli --help }

Step "1) Initialise the term"
Run-SP @("init", $term)

Step "2) Add three assignments (deadline + estimate + priority)"
Run-SP @("add", "Math Homework",  "--due", $d3,  "--est", "60",  "--prio", "Medium")
Run-SP @("add", "CS1302 Project", "--due", $d7,  "--est", "120", "--prio", "High")
Run-SP @("add", "Essay Draft",    "--due", $d15, "--est", "90",  "--prio", "Low")

Step "3) Generate a 150-minute study plan"
Run-SP @("plan", "--mins", "150")

Step "4) Courses and GPA (credit-weighted)"
Run-SP @("add-course", "Calculus",   "--credits", "4", "--grade", "A")
Run-SP @("add-course", "Accounting", "--credits", "3", "--grade", "B+")
Run-SP @("calc-gpa")

Step "5) Deadline urgency (3 / 7 / 15 days)"
Run-SP @("deadline", "--date", $d3)
Run-SP @("deadline", "--date", $d7)
Run-SP @("deadline", "--date", $d15)

Step "6) Exam countdown"
Run-SP @("exam", "--date", $exam)

Step "7) Quiz generator (structured cards, ready for an agent)"
Run-SP @("quiz")

Step "8) Study timer"
Run-SP @("add-time", "120")
Run-SP @("study-hours")

Step "9) Local-first storage: everything is one JSON file"
Get-Content $dataFile

Step "10) The Python API that an agent would call"
if (Test-Path ".\demo.py") {
    & python ".\demo.py"
} else {
    Write-Host "demo.py not found in the current folder." -ForegroundColor Yellow
}
